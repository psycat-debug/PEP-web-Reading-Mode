{
  "manifest_version": 3,
  "name": "PEP-web Reading Mode",
  "version": "1.4.0",
  "description": "Enhances readability and search functionality for PEP-web articles.",
  "author": "Yan Deng",
  "homepage_url": "https://github.com/psycat-debug/PEP-web-Reading-Mode",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://pep-web.org/*"
  ],
  "action": {
    "default_title": "PEP-web Reading Mode"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-search-popup": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Toggle PEP-web Author/Year Search Popup"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://pep-web.org/*", "*://*.pep-web.org/*"],
      "js": ["content.js"],
      "css": ["pep-theme.css"],
      "run_at": "document_idle"
    }
  ]
}
