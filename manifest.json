{
  "manifest_version": 3,
  "name": "PEP-web Reading Mode",
  "version": "2.1",
  "description": "Enhances readability and search functionality for PEP-web articles.",
  "author": "Yan Deng",
  "homepage_url": "https://github.com/psycat-debug/PEP-web-Reading-Mode",
  "action": {
    "default_title": "PEP-web Reading Mode"
  },
  "permissions": [
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.pep-web.org/*", "*://pep-web.org/*"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "toggle-search-popup": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Toggle PEP Search Popup"
    }
  }
}